[Unit]
Description=Server for the MBot Scratch GUI
After=network.target

[Service]
# Use a dedicated start script rather than a complex inline bash command. This keeps the systemd unit clean and allows us to do proper environment checks before starting.
ExecStart=/usr/local/bin/mbot-scratch-gui-start
User=mbot
Restart=always
# Set WorkingDirectory to the actual data directory rather than the hardcoded repo clone path.
WorkingDirectory=/data/www/scratch
# We removed the hardcoded PATH variable that pointed to a specific Node version. The start script will now dynamically source NVM.
Environment=HOME=/home/mbot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
